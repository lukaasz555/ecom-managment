model StaffPasswordRecovery {
  id        Int       @id @default(autoincrement())
  staffId   Int
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  token     String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([staffId], name: "staffId")
}
